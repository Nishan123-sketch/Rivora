PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=weather_app
DB_PASSWORD=REPLACE_WITH_YOUR_PASSWORD
DB_NAME=weather_flood_db

KMA_API_KEY=
KWATER_API_KEY=
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
OTP_SECRET=REPLACE_WITH_ANOTHER_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_APP_PASSWORD=

# Comma-separated local KMA database station IDs for hourly forecast updates (max 20)
KMA_FORECAST_STATION_IDS=
# OFF by default: only enable after station thresholds are verified and tested
ENABLE_AUTOMATIC_ALERTS=false
ENABLE_ALERT_EMAILS=false

# Prediction pipeline (Python 3.10+)
PYTHON_BIN=python
ENABLE_PREDICTIONS=false
PREDICTION_INTERVAL_MINUTES=30
ML_HISTORY_START=
# Empty means rolling 13-month history for completion backfill.
# Requires separate KMA warning-endpoint access; falls back to KMA_API_KEY
KMA_ALERT_API_KEY=

# No previous LLM provider exists in this project; free local Ollama is the default.
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
OLLAMA_BASE_URL=http://127.0.0.1:11434
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Set LLM_PROVIDER=anthropic and LLM_MODEL to a model available to your account.
ALERT_DRY_RUN=true
API_PUBLIC_URL=http://localhost:5000
APP_BASE_URL=http://localhost:5173

# Optional K-water legacy station importer, disabled by default
ENABLE_LEGACY_KWATER_SCHEDULER=false

# Speed: seconds that latest-reading and heavy API responses are cached in memory
LATEST_CACHE_SECONDS=30
API_CACHE_SECONDS=30

# Optional OpenID Connect sign-in; register callback URLs at each provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
UNIVERSITY_OIDC_ISSUER=
UNIVERSITY_OIDC_CLIENT_ID=
UNIVERSITY_OIDC_CLIENT_SECRET=

# Owner-controlled role provisioning. No administrator password belongs here.
ADMIN_EMAIL=
# General announcements are separate from official warning notifications.
ENABLE_ADMIN_EMAILS=false
